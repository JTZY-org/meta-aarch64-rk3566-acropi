# Description: Wic card image for RK3566 Acropi
#
# Part  Start Size
# idbloader 64s
# uboot 16384s
# boot 32768s 128M
# rootfs 262144s -

# 使用 idbloader.img (已软链接到 INI 指定的原始文件名)
part idbloader --source rawcopy --sourceparams="file=idbloader.img" --ondisk mmcblk --no-table --align 32
part uboot --source rawcopy --sourceparams="file=uboot.img" --ondisk mmcblk --no-table --align 8192
part boot --source bootimg-partition --ondisk mmcblk --fstype=vfat --label boot --active --align 16384
part / --source rootfs --ondisk mmcblk --fstype=ext4 --label rootfs --align 131072
