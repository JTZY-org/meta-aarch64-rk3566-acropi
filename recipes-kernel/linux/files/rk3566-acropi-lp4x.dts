&dsi1 {
	status = "okay";
	rockchip,lane-rate = <480>;

	dsi1_panel: panel@0 {
		status = "okay";
		compatible = "simple-panel-dsi";
		reg = <0>;
		bpc = <8>;
		power-supply = <&vcc3v3_sys>;

		/* GPIO 关联 */
		reset-gpios = <&gpio3 RK_PC1 GPIO_ACTIVE_LOW>;   // 屏幕 Reset
		enable-gpios = <&gpio0 RK_PB5 GPIO_ACTIVE_HIGH>;  // 屏幕 Power/Enable (可选)

		pinctrl-names = "default";
		pinctrl-0 = <&dsi1_rst_gpio &lcd_pwr_gpio>;

		/* 关联背光节点 */
		backlight = <&backlight>;

		/* U-Boot 留空时，内核冷启动必须配足的关键延时 */
		reset-delay-ms = <10>;    // Reset 脚保持低电平时间 >= 10ms
		enable-delay-ms = <120>;  // 上电/Reset 拉高后面板内部芯片准备时间 >= 120ms
		init-delay-ms = <120>;    // 新增：复位拉高后至发送初始化序列前的延时
		prepare-delay-ms = <20>;  // 发送 init-sequence 之前的延迟
		unprepare-delay-ms = <20>;
		disable-delay-ms = <50>;

		/* DSI 传输模式 */
		dsi,flags = <(MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
			MIPI_DSI_MODE_LPM | MIPI_DSI_MODE_NO_EOT_PACKET)>;
		dsi,format = <MIPI_DSI_FMT_RGB888>;
		dsi,lanes  = <4>;

		/* 初始化指令序列... (保持之前的 panel-init-sequence) */
		panel-init-sequence = [
			39 00 04 FF 98 81 03
