From cefe28d7b0c8d26540df546055b9e60454a1df9e Mon Sep 17 00:00:00 2001
From: TSKangetsu <x403070567@live.com>
Date: Sat, 21 Mar 2026 15:29:32 +0800
Subject: [PATCH] Add Acropi RK3566 DTS and update Makefile

---
 arch/arm64/boot/dts/rockchip/Makefile         |   1 +
 .../boot/dts/rockchip/rk3566-acropi-lp4x.dts  | 346 ++++++++++++++++++
 2 files changed, 347 insertions(+)
 create mode 100644 arch/arm64/boot/dts/rockchip/rk3566-acropi-lp4x.dts

diff --git a/arch/arm64/boot/dts/rockchip/Makefile b/arch/arm64/boot/dts/rockchip/Makefile
index ecaecd996374..63123253c961 100644
--- a/arch/arm64/boot/dts/rockchip/Makefile
+++ b/arch/arm64/boot/dts/rockchip/Makefile
@@ -153,6 +153,7 @@ dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3566-evb1-ddr4-v10.dtb
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3566-evb1-ddr4-v10-linux.dtb
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3566-evb1-ddr4-v10-lvds.dtb
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3566-evb2-lp4x-v10.dtb
+dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3566-acropi-lp4x.dtb
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3566-evb2-lp4x-v10-edp.dtb
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3566-evb2-lp4x-v10-eink.dtb
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3566-evb2-lp4x-v10-i2s-mic-array.dtb
diff --git a/arch/arm64/boot/dts/rockchip/rk3566-acropi-lp4x.dts b/arch/arm64/boot/dts/rockchip/rk3566-acropi-lp4x.dts
new file mode 100644
index 000000000000..f3e1d8f949cc
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/rk3566-acropi-lp4x.dts
@@ -0,0 +1,346 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Standardized DTS for Acropi RK3566 - Binning Compliant
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/clock/rk3568-cru.h>
+#include <dt-bindings/power/rk3568-power.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/pinctrl/rockchip.h>
+#include "rk3566.dtsi"
+
+/ {
+        model = "Acropi RK3566 Board";
+        compatible = "rockchip,rk3566";
+
+        aliases {
+                mmc0 = &sdhci;
+        };
+
+        fiq-debugger {
+                compatible = "rockchip,fiq-debugger";
+                rockchip,serial-id = <2>;
+                rockchip,wake-irq = <0>;
+                rockchip,irq-mode-enable = <1>;
+                rockchip,baudrate = <1500000>;
+                interrupts = <GIC_SPI 252 IRQ_TYPE_LEVEL_LOW>;
+                pinctrl-names = "default";
+                pinctrl-0 = <&uart2m0_xfer>;
+                status = "disabled";
+        };
+
+        vcc5v0_sys: vcc5v0-sys {
+                compatible = "regulator-fixed";
+                regulator-name = "vcc5v0_sys";
+                regulator-always-on;
+                regulator-boot-on;
+                regulator-min-microvolt = <5000000>;
+                regulator-max-microvolt = <5000000>;
+        };
+
+        vcc3v3_sys: vcc3v3-sys {
+                compatible = "regulator-fixed";
+                regulator-name = "vcc3v3_sys";
+                regulator-always-on;
+                regulator-boot-on;
+                regulator-min-microvolt = <3300000>;
+                regulator-max-microvolt = <3300000>;
+                vin-supply = <&vcc5v0_sys>;
+        };
+
+        cpu_opp_table_fixed: opp-table-cpu {
+                compatible = "operating-points-v2";
+                nvmem-cells = <&cpu_leakage>;
+                nvmem-cell-names = "leakage";
+                rockchip,grf = <&grf>;
+                rockchip,pvtpll = <&grf>;
+                rockchip,pvtm-voltage-sel = <0>;
+                rockchip,avs-enable = <0>;
+                /* Explicitly map all leakage values to L0 column */
+                rockchip,leakage-voltage-sel = <0 255 0>;
+
+                opp-408000000 { 
+                        opp-hz = /bits/ 64 <408000000>; 
+                        opp-microvolt = <1100000>; 
+                        opp-microvolt-L0 = <1100000>;
+                };
+
+                opp-600000000 { 
+                        opp-hz = /bits/ 64 <600000000>; 
+                        opp-microvolt = <1100000>; 
+                        opp-microvolt-L0 = <1100000>;
+                };
+
+                opp-816000000 { 
+                        opp-hz = /bits/ 64 <816000000>; 
+                        opp-microvolt = <1100000>; 
+                        opp-microvolt-L0 = <1100000>;
+                };
+
+                opp-1008000000 { 
+                        opp-hz = /bits/ 64 <1008000000>; 
+                        opp-microvolt = <1100000>; 
+                        opp-microvolt-L0 = <1100000>;
+                };
+
+                opp-1200000000 { 
+                        opp-hz = /bits/ 64 <1200000000>; 
+                        opp-microvolt = <1100000>; 
+                        opp-microvolt-L0 = <1100000>;
+                };
+        };
+
+        gpu_opp_table_fixed: opp-table-gpu {
+                compatible = "operating-points-v2";
+                nvmem-cells = <&gpu_leakage>;
+                nvmem-cell-names = "leakage";
+                rockchip,grf = <&grf>;
+                rockchip,pvtpll = <&grf>;
+                rockchip,pvtm-voltage-sel = <0>;
+                rockchip,avs-enable = <0>;
+                rockchip,leakage-voltage-sel = <0 255 0>;
+
+                opp-200000000 { 
+                        opp-hz = /bits/ 64 <200000000>; 
+                        opp-microvolt = <1100000>; 
+                        opp-microvolt-L0 = <1100000>;
+                };
+
+                opp-400000000 { 
+                        opp-hz = /bits/ 64 <400000000>; 
+                        opp-microvolt = <1100000>; 
+                        opp-microvolt-L0 = <1100000>;
+                };
+
+                opp-600000000 { 
+                        opp-hz = /bits/ 64 <600000000>; 
+                        opp-microvolt = <1100000>; 
+                        opp-microvolt-L0 = <1100000>;
+                };
+
+                opp-800000000 { 
+                        opp-hz = /bits/ 64 <800000000>; 
+                        opp-microvolt = <1100000>; 
+                        opp-microvolt-L0 = <1100000>;
+                };
+        };
+
+        npu_opp_table_fixed: opp-table-npu {
+                compatible = "operating-points-v2";
+                nvmem-cells = <&npu_leakage>;
+                nvmem-cell-names = "leakage";
+                rockchip,grf = <&grf>;
+                rockchip,pvtpll = <&grf>;
+                rockchip,pvtm-voltage-sel = <0>;
+                rockchip,avs-enable = <0>;
+                rockchip,leakage-voltage-sel = <0 255 0>;
+
+                opp-200000000 { 
+                        opp-hz = /bits/ 64 <200000000>; 
+                        opp-microvolt = <1100000>; 
+                        opp-microvolt-L0 = <1100000>;
+                };
+
+                opp-400000000 { 
+                        opp-hz = /bits/ 64 <400000000>; 
+                        opp-microvolt = <1100000>; 
+                        opp-microvolt-L0 = <1100000>;
+                };
+
+                opp-600000000 { 
+                        opp-hz = /bits/ 64 <600000000>; 
+                        opp-microvolt = <1100000>; 
+                        opp-microvolt-L0 = <1100000>;
+                };
+        };
+};
+
+&cpu0 {
+        clocks = <&cru ARMCLK>;
+        operating-points-v2 = <&cpu_opp_table_fixed>;
+        cpu-supply = <&vdd_logic>;
+};
+
+&cpu1 {
+        clocks = <&cru ARMCLK>;
+        operating-points-v2 = <&cpu_opp_table_fixed>;
+        cpu-supply = <&vdd_logic>;
+};
+
+&cpu2 {
+        clocks = <&cru ARMCLK>;
+        operating-points-v2 = <&cpu_opp_table_fixed>;
+        cpu-supply = <&vdd_logic>;
+};
+
+&cpu3 {
+        clocks = <&cru ARMCLK>;
+        operating-points-v2 = <&cpu_opp_table_fixed>;
+        cpu-supply = <&vdd_logic>;
+};
+
+&usb2phy0 {
+        status = "okay";
+        phy-supply = <&vcc5v0_sys>;
+};
+
+&u2phy0_otg {
+        status = "okay";
+};
+
+&usbdrd_dwc3 {
+        status = "okay";
+        dr_mode = "otg";
+        usb-role-switch;
+        maximum-speed = "high-speed"; 
+        snps,usb2-lpm-disable;   
+        snps,dis-u2-freeclk-exists-quirk;
+};
+
+&usbdrd30 {
+        status = "okay";
+};
+
+&scmi {
+        status = "disabled";
+};
+
+&i2c0 {
+        status = "okay";
+        pinctrl-names = "default";
+        pinctrl-0 = <&i2c0_xfer>;
+
+        pmic: pmic@20 {
+                compatible = "rockchip,rk809";
+                reg = <0x20>;
+                interrupt-parent = <&gpio0>;
+                interrupts = <RK_PA3 IRQ_TYPE_LEVEL_LOW>;
+                pinctrl-names = "default";
+                pinctrl-0 = <&pmic_int_l>;
+                rockchip,system-power-controller;
+                rockchip,vcc13-feedback-soc;
+                wakeup-source;
+
+                vcc1-supply = <&vcc3v3_sys>;
+                vcc2-supply = <&vcc3v3_sys>;
+                vcc3-supply = <&vcc3v3_sys>;
+                vcc4-supply = <&vcc3v3_sys>;
+                vcc5-supply = <&vcc3v3_sys>;
+                vcc6-supply = <&vcc3v3_sys>;
+                vcc7-supply = <&vcc3v3_sys>;
+                vcc8-supply = <&vcc3v3_sys>;
+                vcc9-supply = <&vcc3v3_sys>;
+
+                regulators {
+                        vdd_logic: DCDC_REG1 {
+                                regulator-name = "vdd_logic";
+                                regulator-always-on;
+                                regulator-boot-on;
+                                regulator-min-microvolt = <900000>;
+                                regulator-max-microvolt = <1100000>;
+                                regulator-init-microvolt = <900000>;
+                                regulator-ramp-delay = <6001>;
+                                regulator-initial-mode = <0x2>;
+
+                                regulator-state-mem {
+                                        regulator-on-in-suspend;
+                                        regulator-suspend-microvolt = <900000>;
+                                };
+                        };
+
+                        vdd_gpu: DCDC_REG2 {
+                                regulator-name = "vdd_gpu";
+                                regulator-always-on;
+                                regulator-boot-on;
+                                regulator-min-microvolt = <900000>;
+                                regulator-max-microvolt = <1100000>;
+                                regulator-init-microvolt = <900000>;
+                                regulator-ramp-delay = <6001>;
+                                regulator-initial-mode = <0x2>;
+
+                                regulator-state-mem {
+                                        regulator-off-in-suspend;
+                                };
+                        };
+
+                        vcc_ddr: DCDC_REG3 {
+                                regulator-name = "vcc_ddr";
+                                regulator-always-on;
+                                regulator-boot-on;
+                                regulator-initial-mode = <0x2>;
+
+                                regulator-state-mem {
+                                        regulator-on-in-suspend;
+                                };
+                        };
+
+                        vdd_npu: DCDC_REG4 {
+                                regulator-name = "vdd_npu";
+                                regulator-always-on;
+                                regulator-boot-on;
+                                regulator-min-microvolt = <900000>;
+                                regulator-max-microvolt = <1100000>;
+                                regulator-init-microvolt = <900000>;
+                                regulator-ramp-delay = <6001>;
+                                regulator-initial-mode = <0x2>;
+
+                                regulator-state-mem {
+                                        regulator-off-in-suspend;
+                                };
+                        };
+                };
+        };
+};
+
+&pinctrl {
+        pmic {
+                pmic_int_l: pmic-int-l {
+                        rockchip,pins = <0 RK_PA3 RK_FUNC_GPIO &pcfg_pull_up>;
+                };
+        };
+};
+
+&tsadc {
+        status = "okay";
+        rockchip,hw-tshut-mode = <1>;
+        rockchip,hw-tshut-polarity = <0>;
+};
+
+&rknpu {
+        clocks = <&cru CLK_NPU>, <&cru ACLK_NPU>, <&cru HCLK_NPU>;
+        clock-names = "clk", "aclk", "hclk";
+        interrupt-names = "npu_irq";
+        operating-points-v2 = <&npu_opp_table_fixed>;
+        rknpu-supply = <&vdd_npu>;
+        status = "okay";
+};
+
+&gpu {
+        clocks = <&cru CLK_GPU>, <&cru CLK_GPU>;
+        clock-names = "clk_mali", "clk_gpu";
+        operating-points-v2 = <&gpu_opp_table_fixed>;
+        mali-supply = <&vdd_gpu>;
+        status = "okay";
+
+        gpu_power_model: power-model {
+                compatible = "arm,mali-simple-power-model";
+                static-coefficient = <411>;
+                dynamic-coefficient = <733>;
+                ts = <32000 4700 (-80) 2>;
+                thermal-zone = "gpu-thermal";
+        };
+};
+
+&uart2 {
+        status = "okay";
+};
+
+&sdhci {
+        status = "okay";
+        bus-width = <8>;
+        non-removable;
+        no-1-8-v;
+};
