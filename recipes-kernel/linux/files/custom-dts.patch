From: TSKangetsu <x403070567@live.com>
Date: Wed, 4 Feb 2026 10:00:00 +0800
Subject: [PATCH] dts test

Upstream-Status: Inappropriate [configuration]

diff --git a/arch/arm64/boot/dts/rockchip/rk3566-evb2-lp4x-v10.dts b/arch/arm64/boot/dts/rockchip/rk3566-evb2-lp4x-v10.dts
index 3b36bdba12b6..98cd5f9ad021 100644
--- a/arch/arm64/boot/dts/rockchip/rk3566-evb2-lp4x-v10.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3566-evb2-lp4x-v10.dts
@@ -4,5 +4,38 @@
  *
  */
 
+///dts-v1/;
+//
 #include "rk3566-evb2-lp4x-v10.dtsi"
 #include "rk3568-android.dtsi"
+
+/ {
+ //model = "Rockchip RK3566 EVB2 LP4X V10 Board (TaiShan Pi Modified)";
+
+	aliases {
+		mmc0 = &sdhci;
+		mmc1 = &sdmmc0;
+	};
+
+	//chosen {
+	//	bootargs = "earlycon console=ttyS2,115200 root=/dev/mmcblk0p4 rw rootwait";
+	//};
+
+	//fiq-debugger {
+	//	status = "disabled";
+	//};
+};
+
+&sdhci {
+	compatible = "rockchip,dwcmshc-sdhci", "snps,dwcmshc-sdhci";
+	bus-width = <8>;
+	max-frequency = <200000000>;
+	non-removable;
+	pinctrl-names = "default";
+	pinctrl-0 = <&emmc_bus8 &emmc_clk &emmc_cmd &emmc_datastrobe>;
+	status = "okay";
+};
+
+&uart2 {
+	status = "okay";
+};
\ No newline at end of file
