server {
    listen 80 default_server;
    listen [::]:80 default_server;

    root /var/www/localhost/html;
    index index.html index.htm;

    server_name _;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /webdav/ {
        root /var/www/localhost/html;
        dav_methods PUT DELETE MKCOL COPY MOVE;
        create_full_put_path on;
        dav_access user:rw group:rw all:r;
        client_max_body_size 100M;

        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Allow-Origin' '*';
            add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, OPTIONS, PROPFIND';
            add_header 'Access-Control-Allow-Headers' 'Content-Type, Authorization';
            return 204;
        }
        add_header 'Access-Control-Allow-Origin' '*' always;
    }

    location = /APSconfig.json {
        alias /etc/APSconfig.json;
        dav_methods PUT;
        dav_access user:rw group:rw all:r;
        client_max_body_size 2M;

        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Allow-Origin' '*' always;
            add_header 'Access-Control-Allow-Methods' 'GET, PUT, OPTIONS' always;
            add_header 'Access-Control-Allow-Headers' 'Content-Type, Authorization' always;
            return 204;
        }
        add_header 'Access-Control-Allow-Origin' '*' always;
        add_header 'Access-Control-Allow-Methods' 'GET, PUT, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'Content-Type, Authorization' always;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /blackbox.bbl {
        alias /usr/log/Singleflight/SingleflightBlackBox.BBL;

        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Allow-Origin' '*';
            add_header 'Access-Control-Allow-Methods' 'GET, HEAD, OPTIONS';
            add_header 'Access-Control-Allow-Headers' 'Content-Type';
            return 204;
        }

        add_header 'Access-Control-Allow-Origin' '*' always;
        add_header Content-Type "application/octet-stream";
        add_header Content-Disposition "attachment; filename=\"SingleflightBlackBox.BBL\"";
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0";
    }

    error_page 500 502 503 504 /50x.html;
}
