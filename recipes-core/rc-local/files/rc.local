#!/bin/sh -e

# mv /dev/dri/renderD128 /dev/dri/renderD128_disabled
# mv /dev/dma_heap /dev/dma_heap_disabled

v4l2-ctl -d /dev/v4l-subdev3 --set-subdev-fmt pad=0,width=640,height=480 &
tmux new-session -d -s aiq "/usr/bin/rkaiq_3A_server"
tmux new-session -d -s ais "/usr/bin/rkaiq_tool_server"

# aps cali
if [ -f "/usr/bin/Ru_Calibrating" ]; then
        chmod +x "/usr/bin/Ru_Calibrating"
        /usr/bin/Ru_Calibrating
        rm "/usr/bin/Ru_Calibrating"
        reboot
fi

sleep 2
tmux new-session -d -s aps "/usr/bin/RuAPM_Cli -c"
ttyd -W -p 7681 tmux new-session -A -s aps &
#tmux new-session -d -s sin "sinffer wlan0 RuAPS_BEACON_5AEC HT20 5825"
sleep 2
cpu-tool.sh set-freq 1104000 &
migrate-irqs.sh > /home/root/booted &
echo 900000000 > /sys/class/devfreq/fde40000.npu/min_freq & # avoid power set

exit 0
