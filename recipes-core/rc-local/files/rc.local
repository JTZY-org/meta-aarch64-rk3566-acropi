#!/bin/sh -e

# mv /dev/dri/renderD128 /dev/dri/renderD128_disabled
# mv /dev/dma_heap /dev/dma_heap_disabled

CAM_W=$(awk 'BEGIN{RS="}";FS="\n"} /"DevicePATH": *"\/dev\/video0"/ {for(i=1;i<=NF;i++) if($i~/"DeviceWidth"/) {gsub(/[^0-9]/,"",$i); print $i}}' /etc/APSconfig.json 2>/dev/null | tr -cd '0-9')
CAM_H=$(awk 'BEGIN{RS="}";FS="\n"} /"DevicePATH": *"\/dev\/video0"/ {for(i=1;i<=NF;i++) if($i~/"DeviceHeight"/) {gsub(/[^0-9]/,"",$i); print $i}}' /etc/APSconfig.json 2>/dev/null | tr -cd '0-9')

[ -z "$CAM_W" ] && CAM_W=640
[ -z "$CAM_H" ] && CAM_H=480

v4l2-ctl -d /dev/v4l-subdev3 --set-subdev-fmt pad=0,width=$CAM_W,height=$CAM_H 2>/dev/null || true

if [ "$CAM_W" = "1296" ] && [ "$CAM_H" = "972" ]; then
    v4l2-ctl -d /dev/v4l-subdev3 --set-ctrl=vertical_blanking=40 2>/dev/null || true
fi

sleep 1
tmux new-session -d -s aiq "/usr/bin/rkaiq_3A_server"
sleep 1
tmux new-session -d -s ais "/usr/bin/rkaiq_tool_server"

# aps cali
if [ -f "/usr/bin/Ru_Calibrating" ]; then
        chmod +x "/usr/bin/Ru_Calibrating"
        /usr/bin/Ru_Calibrating
        rm "/usr/bin/Ru_Calibrating"
        reboot
fi

sleep 2
# Clean log file if it exceeds 3GB on boot (3221225472 bytes)
if [ -f /usr/log/ruapm_cli.log ]; then
    FILE_SIZE=$(stat -c %s /usr/log/ruapm_cli.log 2>/dev/null || echo 0)
    if [ "$FILE_SIZE" -gt 3221225472 ]; then
        rm -f /usr/log/ruapm_cli.log
    fi
fi
tmux new-session -d -s aps "/usr/bin/RuAPM_Cli -c 2>&1 | tee -a /usr/log/ruapm_cli.log"
ttyd -W -p 7681 tmux new-session -A -s aps &
#tmux new-session -d -s sin "sinffer wlan0 RuAPS_BEACON_5AEC HT20 5825"
sleep 2
cpu-tool.sh set-freq 1104000 &
migrate-irqs.sh > /home/root/booted &
echo 900000000 > /sys/class/devfreq/fde40000.npu/min_freq & # avoid power set

# Start WebSocket web-upgrade service
/etc/init.d/web-upgrade start &

exit 0
